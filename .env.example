# Copy to .env with `make init`. Nothing here is a secret in the lab sense —
# the stack binds to loopback only — but .env is git-ignored all the same.

# Host ports. Every one binds to 127.0.0.1; see docs/decisions/0003-loopback-only.md
TKG_PORT_RESOLVER=8480
TKG_PORT_FUSEKI=3030
TKG_PORT_POSTGRES=55432

# Systems of record
POSTGRES_DB=tkg
POSTGRES_USER=tkg_admin
POSTGRES_PASSWORD=tkg_local_only
# The role the lab reads with. Read-only by construction: see sql/00_schema.sql
TKG_DB_READER=tkg_ro
TKG_DB_READER_PASSWORD=tkg_local_only

# Knowledge layer
TKG_FUSEKI_URL=http://fuseki:3030/tkg
JAVA_OPTIONS=-Xmx2g

# Deterministic estate generation. Change it and every identifier changes.
TKG_SEED=20260924
