{
  "mcpServers": {
    "tkg-sanne": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "--network", "tkg_edge",
               "-v", "/absolute/path/to/trusted-knowledge-graph/secrets/sanne.key:/run/secrets/persona.key:ro",
               "tkg-mcp:latest", "--as", "sanne"]
    }
  }
}
