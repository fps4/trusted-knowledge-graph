{
  "mcpServers": {
    "tkg-mara": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "--network", "tkg_edge", "--user", "1000:1000",
               "-v", "/absolute/path/to/trusted-knowledge-graph/secrets/mara.key:/run/secrets/persona.key:ro",
               "tkg-mcp:latest", "--as", "mara"]
    }
  }
}
