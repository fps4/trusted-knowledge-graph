@prefix ssf:  <https://lab.fps4.dev/firm/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://lab.fps4.dev/firm/> a owl:Ontology ;
    rdfs:label "Firm ontology (lab)" ;
    dct:description """A deliberately small OWL profile: classes, a few domains and
ranges, and nothing that needs a reasoner to be useful. The vocabulary for areas of
law and matter types is a SKOS scheme, not a class hierarchy, so that knowledge
management can own it without a release. M2 maps that scheme onto SALI LMSS.""" ;
    owl:versionInfo "0.4.0 — M3" .

# ── Classes ──────────────────────────────────────────────────────────────────
ssf:Matter       a owl:Class ; rdfs:label "Matter" .
ssf:Client       a owl:Class ; rdfs:label "Client" ;
    rdfs:comment "As the practice management system knows it. The CRM's view is an ssf:Account until something resolves them." .
ssf:Account      a owl:Class ; rdfs:label "CRM account" .
ssf:Contact      a owl:Class ; rdfs:label "Client contact" .
ssf:Person       a owl:Class ; rdfs:label "Person" .
ssf:Office       a owl:Class ; rdfs:label "Office" .
ssf:Jurisdiction a owl:Class ; rdfs:label "Jurisdiction" .
ssf:Assignment   a owl:Class ; rdfs:label "Matter assignment" ;
    rdfs:comment "Who worked a matter, in what role, between which dates. Reified because it is a fact with a validity period, and time is what 'expertise applied over time' is a question about." .
ssf:Restriction  a owl:Class ; rdfs:label "Matter restriction" ;
    rdfs:comment "Recorded by the practice management system. It is the source a barrier rule is compiled from in M1, not the rule itself." .

# ── Identifiers as they are in the source systems ────────────────────────────
ssf:matterRef  a owl:DatatypeProperty ; rdfs:domain ssf:Matter  ; rdfs:range xsd:string .
ssf:clientRef  a owl:DatatypeProperty ; rdfs:domain ssf:Client  ; rdfs:range xsd:string .
ssf:personRef  a owl:DatatypeProperty ; rdfs:domain ssf:Person  ; rdfs:range xsd:string .
ssf:accountRef a owl:DatatypeProperty ; rdfs:domain ssf:Account ; rdfs:range xsd:string .

# ── Matter ───────────────────────────────────────────────────────────────────
ssf:forClient      a owl:ObjectProperty ; rdfs:domain ssf:Matter ; rdfs:range ssf:Client .
ssf:ledBy          a owl:ObjectProperty ; rdfs:domain ssf:Matter ; rdfs:range ssf:Person .
ssf:inJurisdiction a owl:ObjectProperty ; rdfs:domain ssf:Matter ; rdfs:range ssf:Jurisdiction .
ssf:matterType     a owl:ObjectProperty ; rdfs:domain ssf:Matter ; rdfs:range skos:Concept .
ssf:practiceArea   a owl:ObjectProperty ; rdfs:range skos:Concept .
ssf:office         a owl:ObjectProperty ; rdfs:range ssf:Office .
ssf:openedOn       a owl:DatatypeProperty ; rdfs:domain ssf:Matter ; rdfs:range xsd:date .
ssf:closedOn       a owl:DatatypeProperty ; rdfs:domain ssf:Matter ; rdfs:range xsd:date .

# ── People and clients ───────────────────────────────────────────────────────
ssf:givenName  a owl:DatatypeProperty ; rdfs:domain ssf:Person ; rdfs:range xsd:string .
ssf:familyName a owl:DatatypeProperty ; rdfs:domain ssf:Person ; rdfs:range xsd:string .
ssf:grade      a owl:DatatypeProperty ; rdfs:domain ssf:Person ; rdfs:range xsd:string .
ssf:joinedOn   a owl:DatatypeProperty ; rdfs:domain ssf:Person ; rdfs:range xsd:date .
ssf:leftOn     a owl:DatatypeProperty ; rdfs:domain ssf:Person ; rdfs:range xsd:date .
ssf:clientType a owl:ObjectProperty   ; rdfs:domain ssf:Client ; rdfs:range skos:Concept .
ssf:openedAsClientOn a owl:DatatypeProperty ; rdfs:domain ssf:Client ; rdfs:range xsd:date .

# ── CRM ──────────────────────────────────────────────────────────────────────
ssf:accountType          a owl:ObjectProperty ; rdfs:domain ssf:Account ; rdfs:range skos:Concept .
ssf:relationshipPartner  a owl:ObjectProperty ; rdfs:domain ssf:Account ; rdfs:range ssf:Person .
ssf:accountSince         a owl:DatatypeProperty ; rdfs:domain ssf:Account ; rdfs:range xsd:date .
ssf:contactOf            a owl:ObjectProperty ; rdfs:domain ssf:Contact ; rdfs:range ssf:Account .
ssf:jobTitle             a owl:DatatypeProperty ; rdfs:domain ssf:Contact ; rdfs:range xsd:string .

# ── Assignment: the fact with a validity period ──────────────────────────────
ssf:assignmentMatter a owl:ObjectProperty   ; rdfs:domain ssf:Assignment ; rdfs:range ssf:Matter .
ssf:assignmentPerson a owl:ObjectProperty   ; rdfs:domain ssf:Assignment ; rdfs:range ssf:Person .
ssf:assignmentRole   a owl:DatatypeProperty ; rdfs:domain ssf:Assignment ; rdfs:range xsd:string .
ssf:validFrom        a owl:DatatypeProperty ; rdfs:range xsd:date .
ssf:validTo          a owl:DatatypeProperty ; rdfs:range xsd:date .

# ── Restriction (source data; the rule is compiled in M1) ────────────────────
ssf:restrictsMatter  a owl:ObjectProperty   ; rdfs:domain ssf:Restriction ; rdfs:range ssf:Matter .
ssf:ruleId           a owl:DatatypeProperty ; rdfs:domain ssf:Restriction ; rdfs:range xsd:string .
ssf:restrictionKind  a owl:DatatypeProperty ; rdfs:domain ssf:Restriction ; rdfs:range xsd:string .
ssf:setOn            a owl:DatatypeProperty ; rdfs:domain ssf:Restriction ; rdfs:range xsd:date .
ssf:setBy            a owl:DatatypeProperty ; rdfs:domain ssf:Restriction ; rdfs:range xsd:string .

# ── Facts that are not rows (M1) ─────────────────────────────────────────────
# A fact with a source, a confidence and a review state. Reified rather than
# RDF-star so it works on any SPARQL 1.1 store: docs/decisions/0014.
ssf:Fact a owl:Class ; rdfs:label "Fact" ;
    rdfs:comment "A claim with a source, a confidence and a review state. It becomes knowledge when it is confirmed, and says so until it is." .
ssf:factSubject   a owl:ObjectProperty   ; rdfs:domain ssf:Fact .
ssf:factPredicate a owl:ObjectProperty   ; rdfs:domain ssf:Fact .
ssf:factObject    a owl:ObjectProperty   ; rdfs:domain ssf:Fact .
ssf:confidence    a owl:DatatypeProperty ; rdfs:domain ssf:Fact ; rdfs:range xsd:decimal .
ssf:reviewState   a owl:DatatypeProperty ; rdfs:domain ssf:Fact ; rdfs:range xsd:string .
ssf:assertedBy    a owl:ObjectProperty   ; rdfs:domain ssf:Fact ; rdfs:range ssf:Person .
ssf:assertedOn    a owl:DatatypeProperty ; rdfs:domain ssf:Fact ; rdfs:range xsd:date .

# The predicates a Fact may carry. A Fact naming anything else is rejected.
ssf:hadOutcome   a owl:ObjectProperty ; rdfs:label "had outcome" ;
    rdfs:domain ssf:Matter ; rdfs:range skos:Concept .
ssf:hasExpertise a owl:ObjectProperty ; rdfs:label "has expertise in" ;
    rdfs:domain ssf:Person ; rdfs:range skos:Concept .

# A named graph that was derived from something, described in g:prov. Its
# lineage is what decides who may see it: docs/decisions/0008.
ssf:DerivedGraph a owl:Class ; rdfs:label "Derived graph" ;
    rdfs:subClassOf prov:Entity .

# ── Billing (M2) ─────────────────────────────────────────────────────────────
ssf:Invoice       a owl:Class ; rdfs:label "Invoice" .
ssf:invoiceMatter a owl:ObjectProperty   ; rdfs:domain ssf:Invoice ; rdfs:range ssf:Matter .
ssf:invoicedOn    a owl:DatatypeProperty ; rdfs:domain ssf:Invoice ; rdfs:range xsd:date .
ssf:amountEur     a owl:DatatypeProperty ; rdfs:domain ssf:Invoice ; rdfs:range xsd:integer .

# ── The glossary (M2) ────────────────────────────────────────────────────────
# A business term is a skos:Concept in g:glossary with an owner. A term that
# means different things to different owners has readings, and says what to do
# when a question does not choose one. docs/decisions/0015.
ssf:BusinessTerm a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Business term" .
ssf:Reading      a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Reading of a term" ;
    rdfs:comment "One owner's definition of a term that means different things to different owners." .
ssf:owner        a owl:DatatypeProperty ; rdfs:label "owner" ;
    rdfs:comment "Who decides what this means. Not an engineer." .
ssf:hasReading   a owl:ObjectProperty ; rdfs:domain skos:Concept ; rdfs:range skos:Concept .
ssf:readingKey   a owl:DatatypeProperty ; rdfs:range xsd:string .
ssf:onAmbiguous  a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "ask | refuse | default:<reading> — what a question that does not choose a reading gets." .
ssf:servedBy     a owl:DatatypeProperty ; rdfs:comment "The competency-question template that answers this reading." .
ssf:means        a owl:ObjectProperty ; rdfs:comment "A value this term fills into a slot, e.g. fund manager → gl:client-type/fund-manager." .
ssf:meansSlot    a owl:DatatypeProperty .
ssf:meansValue   a owl:ObjectProperty .

# ── Documents (M3) ───────────────────────────────────────────────────────────
# A document is represented by its identifier, matter, type, date and the key of
# its bytes in the document store — never its text. docs/decisions/0006.
ssf:Document       a owl:Class ; rdfs:label "Document" .
ssf:documentMatter a owl:ObjectProperty   ; rdfs:domain ssf:Document ; rdfs:range ssf:Matter .
ssf:docType        a owl:DatatypeProperty ; rdfs:domain ssf:Document ; rdfs:range xsd:string .
ssf:documentDate   a owl:DatatypeProperty ; rdfs:domain ssf:Document ; rdfs:range xsd:date .
ssf:objectKey      a owl:DatatypeProperty ; rdfs:domain ssf:Document ; rdfs:range xsd:string ;
    rdfs:comment "Where the bytes are, in the document store. The only route to them is a presigned URL the access decision permitted." .

# Who worked on a matter, as a document says it — distinct from the assignment
# the practice-management system records, so the two can disagree visibly.
ssf:workedOn     a owl:ObjectProperty ; rdfs:label "worked on" ;
    rdfs:domain ssf:Matter ; rdfs:range ssf:Person .

# A fact extracted from a document names the document, not a person.
ssf:fromDocument a owl:ObjectProperty   ; rdfs:domain ssf:Fact ; rdfs:range ssf:Document .
ssf:extractedBy  a owl:DatatypeProperty ; rdfs:domain ssf:Fact ;
    rdfs:comment "The model and pipeline version that proposed this fact." .
ssf:charStart    a owl:DatatypeProperty ; rdfs:domain ssf:Fact ; rdfs:range xsd:integer ;
    rdfs:comment "Where in the document text the evidence starts. An offset, never the passage: the passage belongs to the index." .
ssf:charEnd      a owl:DatatypeProperty ; rdfs:domain ssf:Fact ; rdfs:range xsd:integer .
